# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results/
/playwright-report/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
debug.log
.next-start-*.log
.next-start-*.err.log
.tmp-next-dev.*
.tmp/

# env files — NEVER commit secrets
.env
.env.local
.env.*.local
.env.production
.env.development
backend/.env
# .env.example is safe to commit (no secrets)
!.env.example

# vercel
.vercel

# firebase local cache
.firebase/

# typescript
*.tsbuildinfo

# git worktrees — isolated development branches
/.worktrees/
next-env.d.ts

# GCP / Firebase credentials — NEVER commit
*-service-account*.json
*-credentials*.json
firebase-adminsdk*.json
*.p12

# Python
__pycache__/
*.pyc
backend/__pycache__/
backend/**/__pycache__/
*.egg-info/
.pytest_cache/

# Docker
docker-compose.override.yml

# Claude Code local tooling — never commit (agent worktrees can reach GB scale)
.claude/
.agents/

# Personal screenshots dropped into the repo for agent review — never commit
Screenshot*.png
Screenshot*.jpg
Screenshot*.jpeg

# Local browser/live-test artifacts — never commit auth state, account JSON, or screenshots
docs/reviews/*-live-app-test-assets/
**/auth-storage-state.json
**/*auth-storage*.json
**/*account-secret*.json
**/signup-account.json

# Graphify generated cache is local; committed graph outputs live in graphify-out/.
graphify-out/cache/

# GraphLite local CLI database/history state is generated; committed seeds live
# in Capsule+ exports and docs.
.graphlite/

# Local dev/run logs and ad-hoc output (never commit)
.next-dev*.log
.next-start*.log
artifacts/*.log
output/
.next-local-persistence/
.next-local-validation/
firebase-debug.log
firestore-debug.log
.playwright-cli/
