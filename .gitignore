# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — NEVER commit secrets
.env
.env.local
.env.*.local
.env.production
.env.development
backend/.env
# .env.example is safe to commit (no secrets)
!.env.example

# vercel
.vercel

# firebase local cache
.firebase/

# typescript
*.tsbuildinfo
next-env.d.ts

# GCP / Firebase credentials — NEVER commit
*-service-account*.json
*-credentials*.json
firebase-adminsdk*.json
*.p12

# Python
__pycache__/
*.pyc
backend/__pycache__/
backend/**/__pycache__/
*.egg-info/
.pytest_cache/

# Docker
docker-compose.override.yml
