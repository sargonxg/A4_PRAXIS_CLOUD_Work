                media_type="application/xml",
                headers={"Content-Disposition": f'attachment; filename="{situation_id}.graphml"'},
            )

        if format == "gexf":
            buf = io.BytesIO()
            nx.write_gexf(G, buf)
            buf.seek(0)
            return StreamingResponse(
                buf,
                media_type="application/xml",
                headers={"Content-Disposition": f'attachment; filename="{situation_id}.gexf"'},
            )

        if format == "json":
