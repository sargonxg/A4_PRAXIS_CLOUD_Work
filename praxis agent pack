            label = data.get("label", node_id).replace("'", "\\'")
            props = ", ".join(f"{k}: {json.dumps(v)}" for k, v in data.items() if isinstance(v, (str, int, float, bool)))
            lines.append(f"MERGE (:{ptype} {{id: '{node_id}', tenant_id: '{tenant_id}', situation_id: '{situation_id}', label: '{label}', {props}}});")
        for u, v, data in G.edges(data=True):
            relation = data.get("relation", "RELATED_TO").upper().split(",")[0].strip()
            weight = data.get("weight", 1.0)
            lines.append(f"MATCH (a {{id: '{u}', tenant_id: '{tenant_id}'}}), (b {{id: '{v}', tenant_id: '{tenant_id}'}}) MERGE (a)-[:{relation} {{weight: {weight}}}]->(b);")
        return "\n".join(lines)

