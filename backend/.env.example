# PRAXIS Backend — Environment Variables
# Copy to .env and fill in values for local development

# ── GCP ──────────────────────────────────────────────────────────────────────
GCP_PROJECT_ID=praxisbytacitus
GCP_REGION=us-central1

# ── Firebase Admin SDK ────────────────────────────────────────────────────────
# Option A (local dev): path to service account JSON file
FIREBASE_CREDENTIALS_PATH=./firebase-service-account.json
# Option B (Cloud Run / CI): full JSON string (set via Secret Manager)
# FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"praxisbytacitus",...}

# ── Neo4j (DIALECTICA graph DB) ───────────────────────────────────────────────
NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-neo4j-password

# ── FalkorDB (alternative graph backend) ─────────────────────────────────────
FALKORDB_HOST=localhost
FALKORDB_PORT=6379

# ── AI Models ─────────────────────────────────────────────────────────────────
GEMINI_MODEL=gemini-2.5-flash
GEMINI_DEEP_MODEL=gemini-2.5-pro
# Optional: set if using Google AI Studio instead of Vertex AI
GOOGLE_AI_API_KEY=

# ── BigQuery ──────────────────────────────────────────────────────────────────
BIGQUERY_DATASET=praxis_analytics

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
# In Cloud Run, *.run.app origins are allowed automatically by the backend
CORS_ORIGINS_STR=http://localhost:3000,http://localhost:3001
# Production example: CORS_ORIGINS_STR=https://praxis.tacitus.me,https://praxis-frontend-abc123-uc.a.run.app
