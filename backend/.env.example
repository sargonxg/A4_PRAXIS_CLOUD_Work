# PRAXIS Backend — Environment Variables
# Copy to .env and fill in values for local development

# ── GCP ──────────────────────────────────────────────────────────────────────
GCP_PROJECT_ID=praxisbytacitus
GCP_REGION=us-central1

# ── Firebase Admin SDK ────────────────────────────────────────────────────────
# Option A (local dev): path to service account JSON file
FIREBASE_CREDENTIALS_PATH=./firebase-service-account.json
# Option B (Cloud Run / CI): full JSON string (set via Secret Manager)
# FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"praxisbytacitus",...}

# ── Neo4j (DIALECTICA graph DB) ───────────────────────────────────────────────
NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-neo4j-password

# ── FalkorDB (alternative graph backend) ─────────────────────────────────────
FALKORDB_HOST=localhost
FALKORDB_PORT=6379

# ── AI Models ─────────────────────────────────────────────────────────────────
GEMINI_MODEL=gemini-2.5-flash
GEMINI_DEEP_MODEL=gemini-2.5-pro
# Optional: set if using Google AI Studio instead of Vertex AI
GOOGLE_AI_API_KEY=

# ── BigQuery ──────────────────────────────────────────────────────────────────
BIGQUERY_DATASET=praxis_analytics

# ── LangGraph Checkpointing (Cloud SQL Postgres) ─────────────────────────────
LANGGRAPH_CHECKPOINT_BACKEND=postgres
LANGGRAPH_DB_INSTANCE_CONNECTION_NAME=praxisbytacitus:us-east4:praxisbytacitus-instance
LANGGRAPH_DB_HOST=10.101.0.3
LANGGRAPH_DB_PORT=5432
LANGGRAPH_DB_NAME=praxis_langgraph
LANGGRAPH_DB_USER=praxis_langgraph
LANGGRAPH_DB_PASSWORD_SECRET=praxis-langgraph-db-password
LANGGRAPH_DB_PASSWORD=

# ── Cognee Memory Layer (disabled until isolated service is provisioned) ─────
COGNEE_ENABLED=false
COGNEE_MODE=disabled
COGNEE_DB_HOST=pgbouncer
COGNEE_DB_PORT=6432
COGNEE_DB_NAME=praxis_cognee
COGNEE_DB_USER=praxis_cognee_app
COGNEE_DB_PASSWORD=
COGNEE_KUZU_PATH=/var/lib/cognee/kuzu
COGNEE_KUZU_GCS_BUCKET=
COGNEE_NEO4J_DATABASE=cognee
COGNEE_LLM_PROVIDER=vertex_ai
COGNEE_LLM_MODEL_PRO=vertex_ai/gemini-3.1-pro-preview
COGNEE_LLM_MODEL_FLASH=vertex_ai/gemini-3-flash
COGNEE_EMBEDDING_MODEL=vertex_ai/text-embedding-005
COGNEE_EMBEDDING_DIMENSIONS=768
COGNEE_LLM_API_KEY=vertex-adc
LLM_API_KEY=vertex-adc
COGNEE_CANDIDATE_FLOOR=0.40
COGNEE_PROMOTION_CEILING=0.60
COGNEE_MAX_CANDIDATES_PER_DOC=50

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
# In Cloud Run, *.run.app origins are allowed automatically by the backend
CORS_ORIGINS_STR=http://localhost:3000,http://localhost:3001
# Production example: CORS_ORIGINS_STR=https://praxis.tacitus.me,https://praxis-frontend-abc123-uc.a.run.app
