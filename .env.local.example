# PRAXIS by TACITUS — Environment Variables
# Copy this file to .env.local and fill in your values.

# =============================================================================
# PYTHON BACKEND (Cloud Run)
# =============================================================================
NEXT_PUBLIC_PRAXIS_BACKEND_URL=http://localhost:8080
NEXT_PUBLIC_SITE_URL=https://praxis.tacitus.me

# =============================================================================
# LANGGRAPH CHECKPOINTING (Cloud SQL Postgres)
# =============================================================================
LANGGRAPH_CHECKPOINT_BACKEND=postgres
LANGGRAPH_DB_INSTANCE_CONNECTION_NAME=praxisbytacitus:us-east4:praxisbytacitus-instance
LANGGRAPH_DB_HOST=10.101.0.3
LANGGRAPH_DB_PORT=5432
LANGGRAPH_DB_NAME=praxis_langgraph
LANGGRAPH_DB_USER=praxis_langgraph
LANGGRAPH_DB_PASSWORD_SECRET=praxis-langgraph-db-password
LANGGRAPH_DB_PASSWORD=

# =============================================================================
# AI PROVIDERS (at least one required for live mode, demo mode works without)
# =============================================================================

# Google AI Studio — Primary AI provider (Gemini 2.5)
GOOGLE_AI_API_KEY=your_google_ai_api_key_here

# Anthropic Claude — Optional secondary analysis engine
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# AI Provider: 'google' (default) or 'vertex'
AI_PROVIDER=google

# =============================================================================
# FIREBASE (required for situation management)
# =============================================================================

# Firebase Admin SDK service account key (JSON string)
# Generate from: Firebase Console > Project Settings > Service Accounts
FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"praxisbytacitus",...}

# ─────────────────────────────────────────────────────────────────────────────
# Firebase configuration — REQUIRED (no fallbacks)
# Get from Firebase Console → Project Settings → Your apps → Web app
# These are public to the browser bundle — not secrets.
# ─────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=    # optional

# =============================================================================
# WEB RESEARCH (optional — enhances research capabilities)
# =============================================================================

# Firecrawl — Web scraping and search
FIRECRAWL_API_KEY=your_firecrawl_api_key_here

# =============================================================================
# VERTEX AI / DEEP RESEARCH AGENT (optional — enables Vertex AI ADK pipeline)
# =============================================================================

# Vertex AI Agent Engine — Deep Research Agent (3-phase: Plan → Research → Synthesize)
# Find in: Google Cloud Console → Vertex AI → Agent Engine → your engine → numeric ID
VERTEX_AGENT_ENGINE_ID=

# Vertex AI region (default: us-central1)
VERTEX_AGENT_LOCATION=us-central1

# GCP project (default: praxisbytacitus)
GOOGLE_CLOUD_PROJECT=praxisbytacitus

# =============================================================================
# LIVE DATA FEEDS (optional — enables real-time intelligence)
# =============================================================================

# ACLED — Armed Conflict Location & Event Data
# Free academic access: https://developer.acleddata.com/
ACLED_API_KEY=your_acled_api_key_here
ACLED_EMAIL=your_email@example.com

# GDELT — Free, no API key required (auto-enabled)

# ReliefWeb — Free, no API key required (auto-enabled)

# =============================================================================
# PAYMENTS (optional — enables subscription billing)
# =============================================================================

# Stripe — Payment processing
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Stripe Price IDs (create products in Stripe Dashboard)
STRIPE_PRICE_ANALYST=price_...       # Analyst plan ($49/mo, 1000 credits)
STRIPE_PRICE_TEAM=price_...          # Team plan ($149/mo, 5000 credits)
STRIPE_PRICE_ENTERPRISE=price_...    # Enterprise plan (custom)
STRIPE_PRICE_CREDITS_100=price_...   # One-time 100 credit pack

# =============================================================================
# EMAIL (optional — enables transactional emails)
# =============================================================================

# Resend — Transactional email (welcome emails, alerts, digests)
# Free tier: 3,000 emails/month → https://resend.com
RESEND_API_KEY=re_...

# =============================================================================
# SYSTEM (required for cron jobs and admin ops)
# =============================================================================

# Secret for Cloud Scheduler cron job auth + POST /api/admin/set-all-credits
# Generate a strong random string: openssl rand -hex 32
CRON_SECRET=

# =============================================================================
# ERROR MONITORING (optional — production error tracking)
# =============================================================================

# Sentry — Error tracking and performance monitoring
# Create project at https://sentry.io → Settings → Projects → Client Keys (DSN)
NEXT_PUBLIC_SENTRY_DSN=https://...@sentry.io/...
