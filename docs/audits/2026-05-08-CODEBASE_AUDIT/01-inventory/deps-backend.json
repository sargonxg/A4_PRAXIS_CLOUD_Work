        "    \"pydantic>=2.10,<3.0\",",
        "    \"pydantic-settings>=2.7,<3.0\",",
        "    \"google-genai>=1.8,<2.0\",",
        "    \"google-cloud-firestore>=2.19,<3.0\",",
        "    \"google-cloud-bigquery>=3.27,<4.0\",",
        "    \"firebase-admin>=6.6,<7.0\",",
        "    \"neo4j>=5.26,<6.0\",",
