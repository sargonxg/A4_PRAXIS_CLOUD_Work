rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function protectedUserFields() {
      return [
        'credits',
        'totalCreditsUsed',
        'subscription',
        'subscriptionExpiresAt',
        'subscriptionProvider',
        'subscriptionStatus',
        'polarCustomerId',
        'polarSubscriptionId',
        'polarProductId',
        'polarTrialEndsAt',
        'fullAccessCode',
        'fullAccessCodeRedeemedAt',
        'fullAccessExpiresAt'
      ];
    }

    function serverOnlyUserCreateFields() {
      return [
        'subscriptionExpiresAt',
        'subscriptionProvider',
        'subscriptionStatus',
        'polarCustomerId',
        'polarSubscriptionId',
        'polarProductId',
        'polarTrialEndsAt',
        'fullAccessCode',
        'fullAccessCodeRedeemedAt',
        'fullAccessExpiresAt'
      ];
    }

    function clientUserCreateFields() {
      return [
        'uid',
        'email',
        'displayName',
        'photoURL',
        'role',
        'orgId',
        'orgName',
        'credits',
        'totalCreditsUsed',
        'isDemo',
        'subscription',
        'createdAt',
        'lastLoginAt',
        'aiProvider',
        'aiSettings',
        'researchProviders',
        'calendarSources',
        'savedItems',
        'tosAcceptedAt',
        'gdprConsentDate',
        'cookieConsentVersion',
        'marketingConsent'
      ];
    }

    function isRootCapsulePublic(capsuleData) {
      return capsuleData.market.visibility in ['public', 'unlisted'];
    }

    function isRootCapsuleOwner(capsuleId) {
      return request.auth != null
             && resource.data.ownerUid == request.auth.uid;
    }

    function canReadRootCapsule(capsuleData) {
      return request.auth != null
             && (capsuleData.ownerUid == request.auth.uid
                 || isRootCapsulePublic(capsuleData)
                 || (capsuleData.market.visibility == 'org'
                     && request.auth.token.orgId != null
                     && request.auth.token.orgId == capsuleData.provenance.author.org));
    }

    // User profiles: owner-only access with field-level protection
    match /users/{uid} {
      // Read: owner only
      allow read: if request.auth != null && request.auth.uid == uid;

      // Update: owner only, but NEVER allow direct modification of credit fields.
      // Credits must only be changed via Admin SDK (server-side).
      allow update: if request.auth != null
                    && request.auth.uid == uid
                    && (!request.resource.data.diff(resource.data).affectedKeys()
                        .hasAny(protectedUserFields()));

      // Allow owner create for client-safe profile fields only. Credits,
      // subscriptions, and promo/full-access fields are server-managed.
      allow create: if request.auth != null
                    && request.auth.uid == uid
                    && request.resource.data.keys().hasOnly(clientUserCreateFields())
                    && request.resource.data.uid == uid
                    && request.resource.data.credits == 5000
                    && request.resource.data.totalCreditsUsed == 0
                    && request.resource.data.subscription == 'free'
                    && request.resource.data.isDemo == false
                    && (!request.resource.data.keys().hasAny(serverOnlyUserCreateFields()));

      allow delete: if false;

      // DIALECTICA provenance graph: owner-only. Rule-chain records sit beside
      // the canonical graph and are never shared across users.
      match /situations/{situationId}/provenance/{stepId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      match /situations/{situationId}/sources/{sourceId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      match /situations/{situationId}/work_products/{workProductId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      match /situations/{situationId}/saved_queries/{queryId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      // All situation subcollections: owner-only
      match /situations/{situationId}/{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      // User settings (model preferences, graph backend): owner-only.
      // API keys are NOT stored here anymore — they live encrypted in the
      // `api_keys_encrypted/providers/{providerId}` subcollection below and
      // are only reachable via the server-side API routes.
      match /settings/{settingDoc} {
        allow read, write: if request.auth != null
                           && request.auth.uid == uid
                           && settingDoc != 'api_keys'
                           && settingDoc != 'api_keys_encrypted';
      }

      // Encrypted user-supplied API keys: SERVER-ONLY via Admin SDK.
      // Clients must never read the ciphertext, AAD, or even existence
      // metadata directly — they go through `/api/settings/api-keys/*` which
      // returns masked previews only.
      match /settings/api_keys_encrypted/providers/{providerId} {
        allow read, write: if false;
      }
      match /settings/api_keys_encrypted {
        allow read, write: if false;
      }

      // Legacy plaintext api_keys doc — kept in rules as deny-all so the
      // migration script can delete it via Admin SDK while clients have no
      // ability to read whatever is left.
      match /settings/api_keys {
        allow read, write: if false;
      }

      // Analyst profile: owner-only access
      match /profile/{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      // Profile versions: owner read only, write denied (Admin SDK only)
      match /profile_versions/{versionId} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow write: if false;
      }

      // Active PRAXIS workspace context stacks: owner-only. Server API routes
      // also write these through Admin SDK for auth/session consistency.
      match /contextStacks/{stackId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      // Canonical PRAXIS context capsules: owner-only. The server-side
      // capsule API keeps legacy contextStacks/default compatible while
      // new Ask, memo, tool, and agent flows converge on this collection.
      match /capsules/{capsuleId} {
        allow read: if request.auth != null
                    && request.auth.uid == uid
                    && resource.data.ownerUid == uid;
        allow write: if request.auth != null
                     && request.auth.uid == uid
                     && request.resource.data.ownerUid == uid;

        match /notes/{noteId} {
          allow read: if request.auth != null
                      && request.auth.uid == uid
                      && resource.data.ownerUid == uid
                      && resource.data.capsuleId == capsuleId;
          allow write: if request.auth != null
                       && request.auth.uid == uid
                       && request.resource.data.ownerUid == uid
                       && request.resource.data.capsuleId == capsuleId;
        }

        match /evaluations/{evaluationId} {
          allow read: if request.auth != null
                      && request.auth.uid == uid
                      && resource.data.ownerUid == uid
                      && resource.data.capsuleId == capsuleId;
          allow write: if request.auth != null
                       && request.auth.uid == uid
                       && request.resource.data.ownerUid == uid
                       && request.resource.data.capsuleId == capsuleId;
        }

        match /sources/{sourceId} {
          allow read: if request.auth != null
                      && request.auth.uid == uid
                      && resource.data.ownerUid == uid
                      && resource.data.capsuleId == capsuleId;
          allow write: if request.auth != null
                       && request.auth.uid == uid
                       && request.resource.data.ownerUid == uid
                       && request.resource.data.capsuleId == capsuleId;
        }

        match /researchDossiers/{dossierId} {
          allow read: if request.auth != null
                      && request.auth.uid == uid
                      && resource.data.ownerUid == uid
                      && resource.data.capsuleId == capsuleId;
          allow write: if request.auth != null
                       && request.auth.uid == uid
                       && request.resource.data.ownerUid == uid
                       && request.resource.data.capsuleId == capsuleId;
        }

        match /claimLedgers/{ledgerId} {
          allow read: if request.auth != null
                      && request.auth.uid == uid
                      && resource.data.ownerUid == uid
                      && resource.data.capsuleId == capsuleId;
          allow write: if request.auth != null
                       && request.auth.uid == uid
                       && request.resource.data.ownerUid == uid
                       && request.resource.data.capsuleId == capsuleId;
        }

        match /humanWorkflowExamples/{workflowId} {
          allow read: if request.auth != null
                      && request.auth.uid == uid
                      && resource.data.ownerUid == uid
                      && resource.data.capsuleId == capsuleId;
          allow write: if request.auth != null
                       && request.auth.uid == uid
                       && request.resource.data.ownerUid == uid
                       && request.resource.data.capsuleId == capsuleId;
        }

        match /sourceRefreshDockets/{docketId} {
          allow read: if request.auth != null
                      && request.auth.uid == uid
                      && resource.data.ownerUid == uid
                      && resource.data.capsuleId == capsuleId;
          allow write: if request.auth != null
                       && request.auth.uid == uid
                       && request.resource.data.ownerUid == uid
                       && request.resource.data.capsuleId == capsuleId;
        }

        match /advisoryMemoryHits/{memoryHitId} {
          allow read: if request.auth != null
                      && request.auth.uid == uid
                      && resource.data.ownerUid == uid
                      && resource.data.capsuleId == capsuleId;
          allow write: if request.auth != null
                       && request.auth.uid == uid
                       && request.resource.data.ownerUid == uid
                       && request.resource.data.capsuleId == capsuleId;
        }

        match /memories/{memoryId} {
          allow read: if request.auth != null
                      && request.auth.uid == uid
                      && resource.data.ownerUid == uid
                      && resource.data.capsuleId == capsuleId;
          allow write: if request.auth != null
                       && request.auth.uid == uid
                       && request.resource.data.ownerUid == uid
                       && request.resource.data.capsuleId == capsuleId;
        }

        match /ontologyGraphs/{graphId} {
          allow read: if request.auth != null
                      && request.auth.uid == uid
                      && resource.data.ownerUid == uid
                      && resource.data.capsuleId == capsuleId;
          allow write: if request.auth != null
                       && request.auth.uid == uid
                       && request.resource.data.ownerUid == uid
                       && request.resource.data.capsuleId == capsuleId;
        }

        match /spans/{spanId} {
          allow read: if request.auth != null
                      && request.auth.uid == uid
                      && resource.data.createdBy == uid
                      && resource.data.capsuleId == capsuleId;
          allow write: if request.auth != null
                       && request.auth.uid == uid
                       && request.resource.data.createdBy == uid
                       && request.resource.data.capsuleId == capsuleId;
        }

        match /outputs/{outputId} {
          allow read: if request.auth != null
                      && request.auth.uid == uid
                      && resource.data.ownerUid == uid
                      && resource.data.capsuleId == capsuleId;
          allow write: if request.auth != null
                       && request.auth.uid == uid
                       && request.resource.data.ownerUid == uid
                       && request.resource.data.capsuleId == capsuleId;
        }
      }

      // Durable generated work products. Full OutputCapsule records live here;
      // capsule-scoped output references are mirrored under /capsules/*/outputs.
      match /outputCapsules/{outputCapsuleId} {
        allow read: if request.auth != null
                    && request.auth.uid == uid
                    && resource.data.ownerUid == uid;
        allow write: if request.auth != null
                     && request.auth.uid == uid
                     && request.resource.data.ownerUid == uid;
      }

      // User-scoped Knowledge Library. These records index existing document
      // uploads into repositories and capsule associations; server APIs own AI
      // digest writes through Admin SDK, while direct client access remains
      // owner-scoped.
      match /knowledgeRepositories/{repositoryId} {
        allow read: if request.auth != null
                    && request.auth.uid == uid
                    && resource.data.ownerUid == uid;
        allow write: if request.auth != null
                     && request.auth.uid == uid
                     && request.resource.data.ownerUid == uid
                     && request.resource.data.scope == 'user';
      }

      match /knowledgeDocuments/{documentId} {
        allow read: if request.auth != null
                    && request.auth.uid == uid
                    && resource.data.ownerUid == uid;
        allow write: if request.auth != null
                     && request.auth.uid == uid
                     && request.resource.data.ownerUid == uid;
      }

      // Structured PRAXIS cores: User Core, Situation Core, Source Core,
      // Document Core, Graph Core, and Output Core records copied or created
      // inside a user workspace. Canonical demo seeds are code-backed; user
      // forks live here and remain owner-scoped.
      match /cores/{coreId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      // Recommended next moves are workspace state derived from active cores.
      match /workspace-next-moves/{moveSetId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      // Durable AgentRun read model. Server runtime mirrors Cloud SQL ledger
      // state here through Admin SDK so clients can stream owner-scoped run
      // timelines with Firestore onSnapshot. Direct client writes stay denied
      // to preserve run/audit integrity.
      match /runs/{runId} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow write: if false;

        match /events/{eventId} {
          allow read: if request.auth != null && request.auth.uid == uid;
          allow write: if false;
        }

        match /toolCalls/{toolCallId} {
          allow read: if request.auth != null && request.auth.uid == uid;
          allow write: if false;
        }

        match /approvals/{approvalId} {
          allow read: if request.auth != null && request.auth.uid == uid;
          allow write: if false;
        }
      }
    }

    // Credit transactions: read own only, write denied (server-only via Admin SDK)
    match /credit_transactions/{transactionId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    // Onboarding suggestions: authenticated read only, write denied (server-only)
    match /config/onboarding_suggestions {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Domain taxonomy: authenticated read, write denied (admin-only via /api/admin/domains).
    // Top-level collections (2-segment doc paths). Admin-only writes go through
    // the API route using Firebase Admin SDK which bypasses these rules.
    match /domains/{domainId} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    match /domains_meta/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    match /domains_history/{historyId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Marketplace Context Capsules: root capsule records are the
    // marketplace/capsule-builder store. Owner draft writes are allowed for
    // clients, but published immutable versions are created only by server
    // routes through Admin SDK and cannot be changed from the client.
    match /capsules/{capsuleId} {
      allow read: if canReadRootCapsule(resource.data);
      allow create: if request.auth != null
                    && request.resource.data.ownerUid == request.auth.uid
                    && request.resource.data.schemaVersion == 'capsule/v2'
                    && request.resource.data.status == 'draft'
                    && request.resource.data.immutable == false;
      allow update: if isRootCapsuleOwner(capsuleId)
                    && resource.data.status == 'draft'
                    && resource.data.immutable == false
                    && request.resource.data.ownerUid == request.auth.uid
                    && request.resource.data.schemaVersion == 'capsule/v2'
                    && request.resource.data.status == 'draft'
                    && request.resource.data.immutable == false;
      allow delete: if false;

      match /versions/{hash} {
        allow read: if request.auth != null
                    && canReadRootCapsule(
                      get(/databases/$(database)/documents/capsules/$(capsuleId)).data
                    );
        allow create: if false;
        allow update, delete: if false;
      }
    }

    // ── Operational spine: tool_runs, background_jobs, system_events ──
    // These are written by Admin SDK / service accounts only. Owners can
    // read their own rows so the dashboard activity feed lights up in
    // real time via onSnapshot.

    match /tool_runs/{toolRunId} {
      allow read: if request.auth != null && resource.data.uid == request.auth.uid;
      allow write: if false;
    }

    match /background_jobs/{jobId} {
      allow read: if request.auth != null
                  && (resource.data.uid == request.auth.uid
                      || (resource.data.uid == null && request.auth.token.admin == true));
      allow write: if false;
    }

    match /system_events/{eventId} {
      // Owner reads only their own; platform events (uid==null) are
      // admin-only via Admin SDK.
      allow read: if request.auth != null && resource.data.uid == request.auth.uid;
      allow write: if false;
    }

    match /alerts/{alertId} {
      allow read: if request.auth != null && resource.data.uid == request.auth.uid;
      allow write: if false;
    }

    match /data_ingestions/{ingestionId} {
      allow read: if request.auth != null && resource.data.uid == request.auth.uid;
      allow write: if false;
    }

    match /audit_logs/{logId} {
      // Audit logs are admin-only. Clients have no read access.
      allow read, write: if false;
    }

    match /advisor_feed_items/{itemId} {
      // Digital advisor control-plane content is server-only. Admin UI reads
      // and writes through /api/admin/advisor-feed with Admin SDK gating.
      allow read, write: if false;
    }

    // ── Per-user notifications (subcollection) ──
    // Owners can read and mark-as-read their own notifications, but
    // cannot create or delete them. Server (Admin SDK) creates them.
    match /users/{uid}/notifications/{notificationId} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow update: if request.auth != null
                    && request.auth.uid == uid
                    && request.resource.data.diff(resource.data).affectedKeys()
                       .hasOnly(['read', 'archived', 'readAt']);
      allow create, delete: if false;
    }

    // graph_updates and tool_outputs live under situations/* and inherit
    // the existing owner-only rule on users/{uid}/situations/{sitId}/{**}.

    // Deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
