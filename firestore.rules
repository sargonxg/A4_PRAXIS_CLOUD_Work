rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // User profiles: owner-only access with field-level protection
    match /users/{uid} {
      // Read: owner only
      allow read: if request.auth != null && request.auth.uid == uid;

      // Write: owner only, but NEVER allow direct modification of credit fields.
      // Credits must only be changed via Admin SDK (server-side).
      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && (!request.resource.data.diff(resource.data).affectedKeys()
                       .hasAny(['credits', 'totalCreditsUsed', 'subscription', 'subscriptionExpiresAt']));

      // Allow create (first sign-up) — ensureUserProfile sets initial credits server-side
      allow create: if request.auth != null && request.auth.uid == uid;

      // All situation subcollections: owner-only
      match /situations/{situationId}/{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      // User settings (model preferences, graph backend): owner-only.
      // API keys are NOT stored here anymore — they live encrypted in the
      // `api_keys_encrypted/providers/{providerId}` subcollection below and
      // are only reachable via the server-side API routes.
      match /settings/{settingDoc} {
        allow read, write: if request.auth != null
                           && request.auth.uid == uid
                           && settingDoc != 'api_keys'
                           && settingDoc != 'api_keys_encrypted';
      }

      // Encrypted user-supplied API keys: SERVER-ONLY via Admin SDK.
      // Clients must never read the ciphertext, AAD, or even existence
      // metadata directly — they go through `/api/settings/api-keys/*` which
      // returns masked previews only.
      match /settings/api_keys_encrypted/providers/{providerId} {
        allow read, write: if false;
      }
      match /settings/api_keys_encrypted {
        allow read, write: if false;
      }

      // Legacy plaintext api_keys doc — kept in rules as deny-all so the
      // migration script can delete it via Admin SDK while clients have no
      // ability to read whatever is left.
      match /settings/api_keys {
        allow read, write: if false;
      }

      // Analyst profile: owner-only access
      match /profile/{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      // Profile versions: owner read only, write denied (Admin SDK only)
      match /profile_versions/{versionId} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow write: if false;
      }
    }

    // Credit transactions: read own only, write denied (server-only via Admin SDK)
    match /credit_transactions/{transactionId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    // Onboarding suggestions: authenticated read only, write denied (server-only)
    match /config/onboarding_suggestions {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Domain taxonomy: authenticated read, write denied (admin-only via /api/admin/domains).
    // Top-level collections (2-segment doc paths). Admin-only writes go through
    // the API route using Firebase Admin SDK which bypasses these rules.
    match /domains/{domainId} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    match /domains_meta/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    match /domains_history/{historyId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
