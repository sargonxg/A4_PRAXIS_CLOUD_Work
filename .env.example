# PRAXIS v6.2.0 — Environment Variables Reference
# Copy to .env.local for local development: cp .env.example .env.local
# For production: set in Cloud Run via Secret Manager (see setup-gcp.sh)
#
# Project: praxisbytacitus (852128226674) · Region: us-central1

# ── Firebase Client SDK (public — safe to commit) ───────────────────────────
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyAHNn4zJdMaxJXziRNa9SmHRFKUvO1q9uA
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=praxisbytacitus.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=praxisbytacitus
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=praxisbytacitus.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=852128226674
NEXT_PUBLIC_FIREBASE_APP_ID=1:852128226674:web:535f771c7a3568462c11eb
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-7R44KT7CDY
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-7R44KT7CDY

# ── Firebase Admin SDK (SECRET — never commit) ──────────────────────────────
# JSON string from Firebase Console > Project Settings > Service Accounts > Generate New Key
# In Cloud Run: mounted from Secret Manager (praxis-firebase-sa)
FIREBASE_SERVICE_ACCOUNT_KEY=

# ── AI Providers ─────────────────────────────────────────────────────────────
# Google AI Studio Gemini key. Genkit's current docs use GOOGLE_GENAI_API_KEY;
# GOOGLE_AI_API_KEY/GEMINI_API_KEY remain accepted aliases for older PRAXIS envs.
GOOGLE_GENAI_API_KEY=
GOOGLE_AI_API_KEY=                               # accepted alias
ANTHROPIC_API_KEY=                               # Optional — Claude Sonnet 4 for deep analysis
AI_PROVIDER=google                               # 'google' (default) or 'vertex'

# ── Vertex AI (Deep Research Agent) ─────────────────────────────────────────
VERTEX_AGENT_ENGINE_ID=                          # Numeric Reasoning Engine ID from Vertex AI
VERTEX_AGENT_LOCATION=us-central1
GOOGLE_CLOUD_PROJECT=praxisbytacitus
# Vertex AI provider mode (alternative to GOOGLE_AI_API_KEY)
GOOGLE_VERTEX_PROJECT=praxisbytacitus           # GCP project for Vertex AI provider
GOOGLE_VERTEX_LOCATION=us-central1              # Vertex AI region

# ── Python Backend ───────────────────────────────────────────────────────────
NEXT_PUBLIC_PRAXIS_BACKEND_URL=http://localhost:8080

# ── LangGraph Checkpointing (Cloud SQL Postgres) ────────────────────────────
LANGGRAPH_CHECKPOINT_BACKEND=postgres
LANGGRAPH_DB_INSTANCE_CONNECTION_NAME=praxisbytacitus:us-east4:praxisbytacitus-instance
LANGGRAPH_DB_HOST=10.101.0.3
LANGGRAPH_DB_PORT=5432
LANGGRAPH_DB_NAME=praxis_langgraph
LANGGRAPH_DB_USER=praxis_langgraph
LANGGRAPH_DB_PASSWORD_SECRET=praxis-langgraph-db-password
LANGGRAPH_DB_PASSWORD=

# ── PRAXIS Agent Run Ledger (Cloud SQL Postgres) ────────────────────────────
# Used by src/lib/agent-runtime/postgres.ts. Prefer Secret Manager in prod.
AGENT_RUNTIME_DATABASE_URL=postgres://praxis_app:<password>@10.101.0.3:5432/praxis
AGENT_RUNTIME_PG_POOL_MAX=5
AGENT_RUNTIME_PG_SSL=false

# ── Cognee Memory Layer (disabled until isolated service is provisioned) ────
COGNEE_ENABLED=false
COGNEE_MODE=disabled
COGNEE_BACKEND_URL=
COGNEE_KUZU_PATH=/var/lib/cognee/kuzu
COGNEE_LLM_PROVIDER=vertex_ai
COGNEE_LLM_MODEL_PRO=vertex_ai/gemini-3.1-pro-preview
COGNEE_LLM_MODEL_FLASH=vertex_ai/gemini-3-flash
COGNEE_EMBEDDING_MODEL=vertex_ai/text-embedding-005
COGNEE_EMBEDDING_DIMENSIONS=768
COGNEE_LLM_API_KEY=vertex-adc
LLM_API_KEY=vertex-adc
COGNEE_CANDIDATE_FLOOR=0.40
COGNEE_PROMOTION_CEILING=0.60
COGNEE_MAX_CANDIDATES_PER_DOC=50

# ── Graph Databases ──────────────────────────────────────────────────────────
NEO4J_URI=                                       # e.g., neo4j+s://xxxx.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=
FALKORDB_HOST=localhost
FALKORDB_PORT=6379

# ── Web Research ─────────────────────────────────────────────────────────────
FIRECRAWL_API_KEY=                               # Optional — firecrawl.dev
PARALLEL_API_KEY=                                # Optional premium — Parallel Search/API/MCP

# ── Data Feeds ───────────────────────────────────────────────────────────────

# ── Payments ─────────────────────────────────────────────────────────────────
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
POLAR_SERVER=production
POLAR_SUCCESS_URL=https://praxis.tacitus.me/app/settings?payment=success&provider=polar&checkout_id={CHECKOUT_ID}
POLAR_PRODUCT_ANALYST=
POLAR_PRODUCT_TEAM=
POLAR_PRODUCT_ENTERPRISE=

# Comma-separated TACITUS access codes that grant one week of full platform access.
# Server-only. Rotate after campaigns or individual pilot cohorts.
PROMO_FULL_ACCESS_CODES=

# ── Infrastructure (SECRET) ──────────────────────────────────────────────────
CRON_SECRET=                                     # [REQUIRED in prod] Cron + admin endpoint auth
COOKIE_SIGNING_SECRET=                           # [REQUIRED] 32+ char random string for HMAC (primary)
SESSION_SECRET=                                  # Alias for COOKIE_SIGNING_SECRET — mounted from same Secret Manager secret for backward compat
ADMIN_ALLOWLIST=                                 # Comma-separated Firebase uids allowed on /app/admin/* routes
ADMIN_EMAIL_ALLOWLIST=giulio@tacitus.me          # Comma-separated verified emails allowed on /app/admin/* routes
USER_KEY_MASTER=                                 # [REQUIRED in prod] Base64-encoded 32-byte AES-256 key for envelope-encrypting user-supplied API keys. Generate locally with: infrastructure/bootstrap-user-key-master.sh --local. In Cloud Run: mounted from Secret Manager (praxis-user-key-master).

# ── Email ────────────────────────────────────────────────────────────────────
RESEND_API_KEY=                                  # Optional — transactional email

# ── Monitoring ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=                          # Optional — Sentry error monitoring

# ── GCP Backend (auto-set in Cloud Run) ──────────────────────────────────────
GCP_PROJECT_ID=praxisbytacitus
GCP_REGION=us-central1
BIGQUERY_DATASET=praxis_analytics
GCS_BUCKET=praxisbytacitus-praxis-uploads

# ── Feature flags ────────────────────────────────────────────────────────────
# Foundation-hardening v1: enables the 4-advisor council, preferences block,
# Danger Zone, skip-nudge banner, and Ask-Praxis profile mutations. Safe to
# leave on — all paths degrade gracefully when infra is missing.
NEXT_PUBLIC_FOUNDATION_V1=1

# ── Maps ─────────────────────────────────────────────────────────────────────
# Google Maps JavaScript API key. Tenant-wide (not per-user) because Maps
# needs a billable project. Restrict the key to your domain(s) in Google
# Cloud Console → APIs & Services → Credentials → Application restrictions
# (HTTP referrers) + API restrictions (Maps JavaScript API only).
# Without this key, IntelligenceMap renders an SVG scatter fallback.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
