# PRAXIS — Environment Variables Reference
# Copy to .env.local for local development.
# For production, set these in Cloud Run environment variables or Secret Manager.
# Grouped by service. Required variables are marked [REQUIRED].

# ── Firebase (Frontend + Backend) ─────────────────────────────────────────────
NEXT_PUBLIC_FIREBASE_API_KEY=                    # [REQUIRED] Firebase Web API key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=                # [REQUIRED] e.g., yourapp.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=praxisbytacitus  # [REQUIRED]
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=             # [REQUIRED] e.g., yourapp.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=        # [REQUIRED]
NEXT_PUBLIC_FIREBASE_APP_ID=                     # [REQUIRED]
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=             # Optional, Google Analytics

# Firebase Admin SDK (Server-side only — keep secret)
FIREBASE_SERVICE_ACCOUNT_KEY=                    # [REQUIRED] JSON string from Firebase Console > Service Accounts

# ── AI Providers ──────────────────────────────────────────────────────────────
GOOGLE_AI_API_KEY=                               # [REQUIRED] Google AI Studio / Gemini API key
ANTHROPIC_API_KEY=                               # Optional — Claude Sonnet 4 for deep analysis
AI_PROVIDER=google                               # 'google' (default) or 'vertex'

# ── Vertex AI (Deep Research Agent) ──────────────────────────────────────────
VERTEX_AGENT_ENGINE_ID=                          # Required for Deep Research Agent (Numeric Reasoning Engine ID)
VERTEX_AGENT_LOCATION=us-central1               # Optional, default: us-central1
GOOGLE_CLOUD_PROJECT=praxisbytacitus             # Optional, default: praxisbytacitus

# ── Python Backend ────────────────────────────────────────────────────────────
NEXT_PUBLIC_PRAXIS_BACKEND_URL=http://localhost:8080  # Backend Cloud Run URL (set automatically by Cloud Build in production)

# ── Graph Databases ───────────────────────────────────────────────────────────
# Neo4j AuraDB (recommended for production)
NEO4J_URI=                                       # e.g., neo4j+s://xxxx.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# FalkorDB (alternative, Redis-compatible)
FALKORDB_HOST=localhost
FALKORDB_PORT=6379

# ── Web Research ──────────────────────────────────────────────────────────────
FIRECRAWL_API_KEY=                               # Optional — Firecrawl for web intelligence (firecrawl.dev)

# ── Data Feeds ────────────────────────────────────────────────────────────────
ACLED_API_KEY=                                   # Optional — ACLED armed conflict data
ACLED_EMAIL=                                     # Optional — ACLED email for API access

# ── Payments ──────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=                               # Optional — Stripe payments
STRIPE_WEBHOOK_SECRET=                           # Optional — Stripe webhook verification
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=              # Optional

# ── Infrastructure ────────────────────────────────────────────────────────────
CRON_SECRET=                                     # [REQUIRED in prod] Shared secret for cron job auth
RESEND_API_KEY=                                  # Optional — transactional email

# ── Monitoring ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=                          # Optional — Sentry error monitoring

# ── GCP (Backend only — auto-set in Cloud Run) ────────────────────────────────
GCP_PROJECT_ID=praxisbytacitus
GCP_REGION=us-central1
BIGQUERY_DATASET=praxis_analytics
GCS_BUCKET=praxisbytacitus-praxis-uploads

# ── Cookie Security ───────────────────────────────────────────────────────────
COOKIE_SIGNING_SECRET=                           # [REQUIRED] Random 32+ char string for session cookie signing
